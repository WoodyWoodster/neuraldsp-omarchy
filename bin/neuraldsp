#!/usr/bin/env bash
#
# neuraldsp — Neural DSP standalone apps on Omarchy/Arch via Wine + PipeASIO.
#
# Source lives in the neuraldsp-omarchy repo (bin/neuraldsp); install.sh
# deploys this file to ~/.local/bin/neuraldsp.
#
# Commands: add, sync, launch, list, doctor
set -euo pipefail

NEURALDSP_HOME="${NEURALDSP_HOME:-$HOME/.local/share/neuraldsp}"
NEURALDSP_PREFIX="${NEURALDSP_PREFIX:-$NEURALDSP_HOME/prefix}"
NEURALDSP_INSTALLERS="${NEURALDSP_INSTALLERS:-$NEURALDSP_HOME/installers}"
APPS_JSON="$NEURALDSP_HOME/apps.json"
DESKTOP_DIR="$HOME/.local/share/applications"
LOG_DIR="$NEURALDSP_HOME/logs"
MARKER_DIR="$NEURALDSP_HOME/.installed"
MENU_JSONC="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
MENU_BASE="$NEURALDSP_HOME/menu-base.json"
ILOK_SIGNIN_MARKER="$NEURALDSP_HOME/.ilok-signin-prompted"

export WINEARCH=win64
export WINEPREFIX="$NEURALDSP_PREFIX"
export WINEDEBUG="${WINEDEBUG:--all}"

# Verified 2026-09-16. Free installer; re-verify if downloads start failing.
ILOK_URL="https://installers.ilok.com/iloklicensemanager/LicenseSupportInstallerWin64.zip"
# Verified 2026-09-16. Login-gated downloads; we never handle credentials.
NDSP_DOWNLOADS_URL="https://www.neuraldsp.com/downloads"

log() { printf 'neuraldsp: %s\n' "$*"; }
die() { printf 'neuraldsp: error: %s\n' "$*" >&2; exit 1; }
require_user() {
  if (( EUID == 0 )); then
    die "run as your user, not root — a root Wine prefix cannot be used from the desktop"
  fi
}
notify() {
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send -u "$1" "$2" "$3" >/dev/null 2>&1 || true
  fi
}

usage() {
  cat <<'EOF'
usage: neuraldsp <command> [args]

  add [file ...]   stage installer(s); with no args, open the Neural DSP
                   downloads page and watch ~/Downloads for new .exe/.msi,
                   moving each finished file into staging (Ctrl-C when done)
  sync [--force]   silent-install iLok if needed, open License Manager once
                   for sign-in (passwords stay on ilok.com), run staged
                   installers, rescan titles, refresh launchers + menu
  launch <name>    open a standalone (fuzzy match); the Guitar menu /
                   Super+Space entries are primary, this is the fallback.
                   `launch ilok` opens iLok License Manager.
  list [--json]    show installed standalones
  doctor           check prefix, PipeASIO, iLok, realtime, PipeWire.
                   Interface presence is info-only and never blocks launch.

env: NEURALDSP_HOME, NEURALDSP_PREFIX, NEURALDSP_INSTALLERS,
     PIPEWIRE_QUANTUM (default 128/48000 on launch), WINEDEBUG
EOF
}

ensure_dirs() {
  mkdir -p "$NEURALDSP_HOME" "$NEURALDSP_INSTALLERS" "$LOG_DIR" "$MARKER_DIR" "$DESKTOP_DIR"
}

# Wine always ships dxgi.dll / d3d11.dll; DXVK is present only if the DLL
# actually contains the DXVK marker.
dxvk_present() {
  local f="$NEURALDSP_PREFIX/drive_c/windows/system32/d3d11.dll"
  [[ -f "$f" ]] && grep -a -q 'DXVK' "$f"
}
pipeasio_present() { [[ -f "$NEURALDSP_PREFIX/drive_c/windows/system32/pipeasio64.dll" ]]; }
vcrun_present() { [[ -f "$NEURALDSP_PREFIX/winetricks.log" ]] && grep -qE '^vcrun2022' "$NEURALDSP_PREFIX/winetricks.log"; }

sevenz() {
  if command -v 7z >/dev/null 2>&1; then
    7z "$@"
  elif command -v 7zz >/dev/null 2>&1; then
    7zz "$@"
  else
    return 1
  fi
}

ensure_prefix() {
  require_user
  ensure_dirs
  # winetricks otherwise hits GitHub on every run to check for a newer script.
  export WINETRICKS_LATEST_VERSION_CHECK="${WINETRICKS_LATEST_VERSION_CHECK:-disabled}"
  if [[ ! -d "$NEURALDSP_PREFIX/drive_c" ]]; then
    log "creating isolated Wine prefix at $NEURALDSP_PREFIX ..."
    wine wineboot --init >>"$LOG_DIR/prefix.log" 2>&1 || die "wineboot failed (see $LOG_DIR/prefix.log)"
  fi
  local verbs=()
  dxvk_present || verbs+=(dxvk)
  vcrun_present || verbs+=(vcrun2022)
  if ((${#verbs[@]})); then
    log "installing ${verbs[*]} (one winetricks pass; repeats use the cache) ..."
    winetricks -q "${verbs[@]}" >>"$LOG_DIR/prefix.log" 2>&1 || die "winetricks ${verbs[*]} failed (see $LOG_DIR/prefix.log)"
  fi
  if ! pipeasio_present; then
    log "registering PipeASIO ..."
    command -v pipeasio-register >/dev/null 2>&1 || die "pipeasio-register not found — install the pipeasio package first"
    pipeasio-register >>"$LOG_DIR/prefix.log" 2>&1 || die "pipeasio-register failed (see $LOG_DIR/prefix.log)"
  fi
}

ilok_detect() {
  local c
  for c in \
    "$NEURALDSP_PREFIX/drive_c/Program Files/iLok License Manager/iLok License Manager.exe" \
    "$NEURALDSP_PREFIX/drive_c/Program Files (x86)/iLok License Manager/iLok License Manager.exe" \
  ; do
    if [[ -f "$c" ]]; then printf '%s' "$c"; return 0; fi
  done
  return 1
}

ilok_stage_bootstrap() {
  local zip="$NEURALDSP_INSTALLERS/LicenseSupportInstallerWin64.zip"
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/neuraldsp"
  local cached="$cache_dir/LicenseSupportInstallerWin64.zip"
  mkdir -p "$NEURALDSP_INSTALLERS" "$cache_dir"
  if [[ ! -f "$zip" ]]; then
    if [[ -f "$cached" ]]; then
      log "using cached iLok installer ..."
      cp -al "$cached" "$zip" 2>/dev/null || cp -a "$cached" "$zip"
    else
      log "downloading free iLok installer ..."
      if ! curl -fSL -o "$zip" "$ILOK_URL"; then
        rm -f "$zip"
        notify critical "Neural DSP setup" "iLok download failed. Stage it manually: neuraldsp add <iLokInstaller>"
        die "iLok download failed. Get it from https://www.ilok.com and stage it with: neuraldsp add <file>"
      fi
      cp -al "$zip" "$cached" 2>/dev/null || cp -a "$zip" "$cached"
    fi
  elif [[ ! -f "$cached" ]]; then
    cp -al "$zip" "$cached" 2>/dev/null || cp -a "$zip" "$cached"
  fi
  local dir="$NEURALDSP_HOME/.ilok-work"
  rm -rf "$dir"; mkdir -p "$dir"
  unzip -q -o "$zip" -d "$dir" || die "could not extract $zip (install unzip and retry)"
  ILOK_BOOTSTRAP="$(find "$dir" -maxdepth 3 -iname 'License Support*.exe' ! -iname '*uninstall*' | head -1 || true)"
  [[ -n "${ILOK_BOOTSTRAP:-}" ]] || die "License Support installer not found inside $zip"
}

# Extract *.msi from an InstallShield ISSetupStream payload (PACE 5.10.x).
# Decrypt is the public ISSetupStream algorithm (nibble-swap XOR + zlib).
# The EXE embeds a dummy ISSetupStream (count=0) before the real one — try
# every header, not just the first match.
ilok_extract_iss() {
  local exe="$1" dest="$2"
  python3 - "$exe" "$dest" <<'PY'
import struct, sys, zlib
from itertools import cycle, islice
from pathlib import Path

def try_stream(data, off, dest):
    buf = memoryview(data)[off:]
    i = 0

    def read(n):
        nonlocal i
        x = bytes(buf[i:i + n])
        i += n
        return x

    def u16():
        nonlocal i
        x = struct.unpack_from("<H", buf, i)[0]
        i += 2
        return x

    def u32():
        nonlocal i
        x = struct.unpack_from("<I", buf, i)[0]
        i += 4
        return x

    if read(14) != b"ISSetupStream\x00":
        return 0
    count = u16()
    if count == 0:
        return 0
    i += 0x04 + 0x08 + 0x02 + 0x10
    wrote = 0
    for _ in range(count):
        name_len = u32()
        flags = u32()
        i += 2
        size = u32()
        i += 8
        is_unicode = u16()
        name = read(name_len).decode("utf-16le", "replace")
        blob = bytearray(read(size))
        if not name.lower().endswith(".msi"):
            continue
        seed = name.encode("utf-8")
        key = bytes(x ^ k for x, k in zip(seed, cycle(b"\x13\x35\x86\x07")))
        if flags & 4:
            key = bytes(islice(cycle(key), 0, 1024))
        kl = len(key)
        for j, bv in enumerate(blob):
            k = key[j % kl]
            blob[j] = (~(k ^ ((bv << 4 | bv >> 4) & 0xFF))) & 0xFF
        out = bytes(blob)
        if is_unicode:
            out = zlib.decompress(out)
        (dest / Path(name.replace("\\", "/")).name).write_bytes(out)
        wrote += 1
    return wrote

exe, dest = Path(sys.argv[1]), Path(sys.argv[2])
data = exe.read_bytes()
dest.mkdir(parents=True, exist_ok=True)
wrote = 0
start = 0
while True:
    off = data.find(b"ISSetupStream\x00", start)
    if off < 0:
        break
    start = off + 1
    try:
        wrote += try_stream(data, off, dest)
    except Exception:
        continue
sys.exit(0 if wrote else 1)
PY
}

# Extract inner MSIs: ISSetupStream first (5.10.x), then 7z (WiX Burn 6.x).
ilok_extract_msis() {
  local exe="$1" dest="$2"
  rm -rf "$dest"; mkdir -p "$dest"
  if ilok_extract_iss "$exe" "$dest"; then
    return 0
  fi
  if sevenz x -y "-o$dest" "$exe" >/dev/null 2>&1; then
    local cab
    while IFS= read -r cab; do
      sevenz x -y "-o$dest" "$cab" >/dev/null 2>&1 || true
    done < <(find "$dest" -iname '*.cab' 2>/dev/null || true)
    if find "$dest" -iname '*.msi' 2>/dev/null | grep -q .; then
      return 0
    fi
  fi
  return 1
}

# Wine 11 + PACE 6.x: relax OS launch condition and skip WiX service-recovery.
# If the tables/rows are absent (older InstallShield MSIs), leave the file as-is.
ilok_patch_msi() {
  local src="$1" dst="$2"
  cp "$src" "$dst"
  chmod u+w "$dst"
  command -v msiinfo >/dev/null 2>&1 || return 0
  command -v msibuild >/dev/null 2>&1 || return 0
  local tmp launch_orig launch_new seq_orig seq_new
  if [[ -d /dev/shm && -w /dev/shm ]]; then
    tmp="$(mktemp -d /dev/shm/ilok-msi.XXXXXX)"
  else
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/ilok-msi.XXXXXX")"
  fi
  launch_orig="$tmp/LaunchCondition.idt"
  launch_new="$tmp/LaunchCondition.patched.idt"
  seq_orig="$tmp/InstallExecuteSequence.idt"
  seq_new="$tmp/InstallExecuteSequence.patched.idt"
  local patched=0
  if msiinfo export "$dst" LaunchCondition >"$launch_orig" 2>/dev/null; then
    if awk -F '\t' -v OFS='\t' '
      NR <= 3 { print; next }
      index($1, "COMPATIBLE_OS_VERSION") { $1 = "Installed Or 1"; found++ }
      { print }
      END { exit(found == 1 ? 0 : 1) }
    ' "$launch_orig" >"$launch_new"; then
      patched=1
    else
      cp "$launch_orig" "$launch_new"
    fi
  fi
  if msiinfo export "$dst" InstallExecuteSequence >"$seq_orig" 2>/dev/null; then
    if awk -F '\t' -v OFS='\t' '
      NR <= 3 { print; next }
      $1 == "Wix4SchedServiceConfig_X86" { $2 = "0"; found++ }
      { print }
      END { exit(found == 1 ? 0 : 1) }
    ' "$seq_orig" >"$seq_new"; then
      patched=1
    else
      cp "$seq_orig" "$seq_new"
    fi
  fi
  if [[ "$patched" == 1 ]]; then
    local args=()
    [[ -f "$launch_new" ]] && args+=("$launch_new")
    [[ -f "$seq_new" ]] && args+=("$seq_new")
    if ((${#args[@]})) && ! msibuild "$dst" -i "${args[@]}" >/dev/null 2>&1; then
      log "WARNING: MSI patch failed; installing the unpatched MSI"
      cp "$src" "$dst"
    fi
  fi
  rm -rf "$tmp"
}

ilok_msiexec_silent() {
  local msi="$1" logf="$2"
  wine msiexec /i "$msi" BURNMSIINSTALL=1 /qn /norestart /L*v "$logf" >>"$LOG_DIR/install.log" 2>&1 || true
}

ilok_try_msi_silent() {
  local exe="$1" work="$NEURALDSP_HOME/.ilok-msi" msi bonjour patched
  log "trying silent iLok install (extract MSI from installer) ..."
  ilok_extract_msis "$exe" "$work" || return 1
  log "extracted $(find "$work" -iname '*.msi' 2>/dev/null | wc -l) MSI(s)"
  bonjour="$(find "$work" -iname '*bonjour*.msi' 2>/dev/null | head -1 || true)"
  msi="$(find "$work" \( -iname '*licensesupport*.msi' -o -iname '*pace*license*.msi' \) 2>/dev/null | head -1 || true)"
  if [[ -z "${msi:-}" ]]; then
    msi="$(find "$work" -iname '*.msi' ! -iname '*bonjour*' 2>/dev/null | head -1 || true)"
  fi
  [[ -n "${msi:-}" ]] || return 1
  if [[ -n "${bonjour:-}" ]]; then
    log "installing Bonjour (non-vital) ..."
    ilok_msiexec_silent "$bonjour" "$LOG_DIR/ilok-bonjour.log"
  fi
  patched="$work/LicenseSupport-patched.msi"
  ilok_patch_msi "$msi" "$patched"
  log "silent-installing PACE License Support ..."
  ilok_msiexec_silent "$patched" "$LOG_DIR/ilok-msi.log"
  ilok_detect >/dev/null || return 1
}

ilok_gui_fallback() {
  local exe="$1"
  notify low "Neural DSP setup" "iLok installer opening — click through it if asked."
  log "silent iLok install failed — opening the installer on the desktop ..."
  if command -v uwsm-app >/dev/null 2>&1; then
    uwsm-app -- wine "$exe" >>"$LOG_DIR/install.log" 2>&1 || true
  else
    wine "$exe" >>"$LOG_DIR/install.log" 2>&1 || true
  fi
}

# Wine's MSI also writes Linux .desktop files outside the prefix.
ilok_remove_wine_shortcuts() {
  rm -f "$HOME/iLok License Manager.desktop" \
    "$HOME/Desktop/iLok License Manager.desktop" \
    "$HOME/.local/share/applications/wine/Programs/iLok License Manager.desktop" \
    "$HOME/.local/share/applications/wine-Programs-iLok License Manager.desktop" \
    "$HOME/.config/menus/applications-merged/wine-Programs-iLok License Manager.menu"
  find "$HOME/.local/share/icons" -iname '*ilok*' -delete 2>/dev/null || true
  rmdir "$HOME/.local/share/applications/wine/Programs" 2>/dev/null || true
  rmdir "$HOME/.local/share/applications/wine" 2>/dev/null || true
}

write_ilok_desktop() {
  local path="$DESKTOP_DIR/neuraldsp-ilok.desktop"
  mkdir -p "$DESKTOP_DIR"
  cat >"$path" <<EOF
[Desktop Entry]
Type=Application
Name=iLok License Manager
Comment=Activate Neural DSP licenses — sign in on ilok.com
Exec=$(exec_bin) launch ilok
Terminal=false
Categories=AudioVideo;Audio;
StartupNotify=true
EOF
  chmod 755 "$path"
}

prompt_ilok_signin() {
  if [[ -f "$ILOK_SIGNIN_MARKER" ]]; then
    return 0
  fi
  local exe
  exe="$(ilok_detect)" || return 0
  notify low "Neural DSP setup" "Sign in to iLok to activate Neural DSP licenses"
  log "opening iLok License Manager — sign in there. This tool never handles iLok passwords."
  if command -v uwsm-app >/dev/null 2>&1; then
    uwsm-app -- "$(exec_bin)" launch ilok >/dev/null 2>&1 &
  else
    wine "$exe" >>"$LOG_DIR/ilok.log" 2>&1 &
  fi
  disown 2>/dev/null || true
  : >"$ILOK_SIGNIN_MARKER"
}

ensure_ilok() {
  if ilok_detect >/dev/null; then
    log "iLok License Manager present"
  else
    log "iLok License Manager not found — prerequisite, installing first."
    local inst
    ilok_stage_bootstrap
    inst="$ILOK_BOOTSTRAP"
    if ilok_try_msi_silent "$inst"; then
      log "iLok installed (silent MSI)."
    else
      # InstallShield /s on 5.10.x ignores silence and opens the wizard — skip it.
      ilok_gui_fallback "$inst"
    fi
    if ilok_detect >/dev/null; then
      log "iLok installed."
      notify low "Neural DSP setup" "iLok License Manager installed."
    else
      notify normal "Neural DSP setup" "iLok installer finished but the manager was not detected. Open it from the Guitar menu and sign in."
      log "WARNING: iLok manager not detected after the installer run. Open it from the Guitar menu (or: neuraldsp launch ilok) and sign in."
    fi
  fi
  ilok_remove_wine_shortcuts
  if ilok_detect >/dev/null; then
    write_ilok_desktop
    prompt_ilok_signin
  fi
}

run_staged() {
  local force="$1" f sha marker
  if [[ "$force" == 1 ]]; then rm -f "$MARKER_DIR"/*.done 2>/dev/null || true; fi
  shopt -s nullglob
  for f in "$NEURALDSP_INSTALLERS"/*.exe "$NEURALDSP_INSTALLERS"/*.msi; do
    sha="$(sha1sum "$f" | cut -d' ' -f1)"
    marker="$MARKER_DIR/$sha.done"
    if [[ -f "$marker" ]]; then continue; fi
    notify low "Neural DSP setup" "Installing $(basename "$f") — click through it."
    log "running installer: $(basename "$f") ..."
    wine "$f" >>"$LOG_DIR/install.log" 2>&1 || log "WARNING: installer exited nonzero (often harmless for GUI installers)"
    printf '%s\n' "$f" >"$marker"
  done
  shopt -u nullglob
}

rescan_catalog() {
  python3 - "$NEURALDSP_PREFIX" "$APPS_JSON" <<'EOF'
import json, os, re, sys
prefix, out = sys.argv[1], sys.argv[2]
roots = [os.path.join(prefix, "drive_c/Program Files/Neural DSP"),
         os.path.join(prefix, "drive_c/Program Files (x86)/Neural DSP")]
skip = re.compile(r'unins|uninstall', re.I)
apps = []
for root in roots:
    if not os.path.isdir(root):
        continue
    for dirpath, _dirs, files in os.walk(root):
        for f in files:
            if not f.lower().endswith(".exe"):
                continue
            if skip.search(f):
                continue
            display = f[:-4]
            slug = re.sub(r'[^a-z0-9]+', '-', display.lower()).strip('-')
            if not slug:
                continue
            apps.append({"slug": slug, "name": display,
                         "exe": os.path.join(dirpath, f)})
seen, dedup = set(), []
for a in sorted(apps, key=lambda a: a["name"].lower()):
    if a["slug"] in seen:
        continue
    seen.add(a["slug"])
    dedup.append(a)
with open(out, "w") as fh:
    json.dump({"apps": dedup}, fh, indent=2)
    fh.write("\n")
print(f"neuraldsp: catalog: {len(dedup)} standalone(s)")
EOF
}

exec_bin() {
  local dep="$HOME/.local/bin/neuraldsp"
  if [[ -x "$dep" ]]; then printf '%s' "$dep"; else printf '%s' "$(readlink -f "$0")"; fi
}

gen_desktops() {
  python3 - "$APPS_JSON" "$DESKTOP_DIR" "$(exec_bin)" <<'EOF'
import json, os, sys
apps_json, ddir, binp = sys.argv[1], sys.argv[2], sys.argv[3]
os.makedirs(ddir, exist_ok=True)
data = {"apps": []}
if os.path.exists(apps_json):
    with open(apps_json) as fh:
        data = json.load(fh)
slugs = set()
keep = {"ilok"}
for a in data.get("apps", []):
    slugs.add(a["slug"])
    path = os.path.join(ddir, f"neuraldsp-{a['slug']}.desktop")
    with open(path, "w") as fh:
        fh.write("[Desktop Entry]\nType=Application\n"
                 f"Name={a['name']}\n"
                 "Comment=Neural DSP standalone (Wine + PipeASIO)\n"
                 f"Exec={binp} launch {a['slug']}\n"
                 "Terminal=false\nCategories=AudioVideo;Audio;\nStartupNotify=true\n")
    os.chmod(path, 0o755)
for f in os.listdir(ddir):
    if f.startswith("neuraldsp-") and f.endswith(".desktop"):
        slug = f[len("neuraldsp-"):-len(".desktop")]
        if slug not in slugs and slug not in keep:
            os.remove(os.path.join(ddir, f))
            print(f"neuraldsp: removed stale launcher {f}")
print(f"neuraldsp: launchers: {len(slugs)} desktop entr(ies)")
EOF
}

gen_menu() {
  python3 - "$MENU_JSONC" "$MENU_BASE" "$APPS_JSON" <<'EOF'
import json, os, re, shutil, sys, time
menu_path, base_path, apps_json = sys.argv[1], sys.argv[2], sys.argv[3]

def strip_comments(s):
    out, i, n, instr = [], 0, len(s), None
    while i < n:
        c = s[i]
        if instr:
            out.append(c)
            if c == "\\":
                if i + 1 < n:
                    out.append(s[i + 1])
                i += 2
                continue
            if c == instr:
                instr = None
            i += 1
            continue
        if c in ('"', "'"):
            instr = c
            out.append(c)
            i += 1
            continue
        if c == "/" and i + 1 < n and s[i + 1] == "/":
            while i < n and s[i] != "\n":
                i += 1
            continue
        if c == "/" and i + 1 < n and s[i + 1] == "*":
            i += 2
            while i + 1 < n and not (s[i] == "*" and s[i + 1] == "/"):
                i += 1
            i += 2
            continue
        out.append(c)
        i += 1
    return "".join(out)

data = {}
if os.path.exists(menu_path):
    try:
        data = json.loads(strip_comments(open(menu_path).read())) or {}
    except Exception as e:
        print(f"neuraldsp: WARNING: could not parse {menu_path}: {e}; menu left untouched")
        sys.exit(0)

base = {"guitar": {"icon": "", "label": "Guitar",
                   "description": "Neural DSP standalone guitar apps"}}
if os.path.exists(base_path):
    with open(base_path) as fh:
        base = json.load(fh)

apps = []
if os.path.exists(apps_json):
    with open(apps_json) as fh:
        apps = json.load(fh).get("apps", [])

new = {k: v for k, v in data.items()
       if k != "guitar" and not k.startswith("guitar.")}
new.update(base)
for a in apps:
    new[f"guitar.{a['slug']}"] = {
        "icon": "", "label": a["name"],
        "action": f"uwsm-app -- neuraldsp launch {a['slug']}",
        "description": "Neural DSP standalone"}

if new == data:
    print("neuraldsp: menu: up to date")
    sys.exit(0)
if os.path.exists(menu_path):
    shutil.copy2(menu_path, f"{menu_path}.bak.{int(time.time())}")
os.makedirs(os.path.dirname(menu_path), exist_ok=True)
with open(menu_path, "w") as fh:
    json.dump(new, fh, indent=2)
    fh.write("\n")
print(f"neuraldsp: menu: wrote {len([k for k in new if k == 'guitar' or k.startswith('guitar.')])} guitar row(s)")
EOF
}

downloads_dir() {
  local d=""
  if command -v xdg-user-dir >/dev/null 2>&1; then
    d="$(xdg-user-dir DOWNLOAD 2>/dev/null || true)"
  fi
  printf '%s' "${d:-${XDG_DOWNLOAD_DIR:-$HOME/Downloads}}"
}

# True once the file exists, is non-empty, and its size has not changed for 1s
# (Chrome/Firefox rename .crdownload/.part → .exe when the transfer finishes).
file_download_complete() {
  local p="$1" a b
  [[ -f "$p" ]] || return 1
  case "$(basename "$p")" in
    *.crdownload|*.part|*.tmp|*.download|*.partial) return 1 ;;
  esac
  a="$(stat -c%s "$p" 2>/dev/null || echo 0)"
  [[ "$a" != 0 ]] || return 1
  sleep 1
  b="$(stat -c%s "$p" 2>/dev/null || echo 0)"
  [[ "$a" == "$b" ]]
}

stage_one() {
  local src="$1" mode="${2:-cp}" dest="$NEURALDSP_INSTALLERS/$(basename "$src")"
  if [[ -f "$dest" ]]; then
    log "already staged: $(basename "$src")"
    return 0
  fi
  if [[ "$mode" == mv ]]; then
    mv "$src" "$dest"
  else
    cp "$src" "$dest"
  fi
  log "staged: $(basename "$dest")"
  notify low "Neural DSP" "Staged $(basename "$dest")"
}

watch_downloads_and_stage() {
  local dl n=0 f base
  dl="$(downloads_dir)"
  [[ -d "$dl" ]] || die "Downloads folder not found: $dl — pass a file instead: neuraldsp add <installer.exe>"

  xdg-open "$NDSP_DOWNLOADS_URL" >/dev/null 2>&1 &
  notify low "Neural DSP" "Log in on neuraldsp.com and download your installer(s). I'll move them when they finish."
  log "opened Neural DSP downloads."
  log "watching $dl for new .exe/.msi — download as many as you want, Ctrl-C when done."

  declare -A seen=()
  shopt -s nullglob
  for f in "$dl"/*.exe "$dl"/*.msi "$dl"/*.EXE "$dl"/*.MSI; do
    seen["$(basename "$f")"]=1
  done

  trap 'echo; log "staged $n installer(s). next: neuraldsp sync"; exit 0' INT

  while true; do
    for f in "$dl"/*.exe "$dl"/*.msi "$dl"/*.EXE "$dl"/*.MSI; do
      base="$(basename "$f")"
      [[ -z "${seen[$base]:-}" ]] || continue
      file_download_complete "$f" || continue
      if stage_one "$f" mv; then
        n=$((n + 1))
      fi
      seen["$base"]=1
    done
    sleep 1
  done
}

cmd_add() {
  require_user
  ensure_dirs
  if [[ $# -eq 0 ]]; then
    watch_downloads_and_stage
    return 0
  fi
  local f
  for f in "$@"; do
    [[ -f "$f" ]] || die "not a file: $f"
    stage_one "$f" cp
  done
  log "run: neuraldsp sync"
}

cmd_sync() {
  require_user
  local force=0
  [[ "${1:-}" == "--force" ]] && force=1
  ensure_prefix
  ensure_ilok
  run_staged "$force"
  rescan_catalog
  gen_desktops
  gen_menu
  local n
  n="$(python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1])).get("apps",[])))' "$APPS_JSON")"
  if [[ "$n" == 0 ]]; then
    notify normal "Neural DSP setup" "Sync done, no standalones found yet. Stage installers with: neuraldsp add"
    log "sync done — no standalones found yet. Stage installers with: neuraldsp add"
  else
    notify low "Neural DSP setup" "Sync done — $n standalone(s) ready in the Guitar menu."
    log "sync done — $n standalone(s). Open them from the Guitar menu or Super+Space."
  fi
}

match_app() {
  python3 - "$APPS_JSON" "$1" <<'EOF'
import json, sys
apps_json, q = sys.argv[1], sys.argv[2].lower()
try:
    apps = json.load(open(apps_json)).get("apps", [])
except Exception:
    apps = []
hits = [a for a in apps if q in a["slug"] or q in a["name"].lower()]
if not hits:
    print("NONE")
elif len(hits) > 1:
    print("MULTI")
    for a in hits:
        print(f"{a['slug']} — {a['name']}")
else:
    a = hits[0]
    print(f"{a['slug']}\t{a['name']}\t{a['exe']}")
EOF
}

run_standalone() {
  local slug="$1" name="$2" exe="$3"
  local logf="$LOG_DIR/$slug.log"
  [[ -f "$exe" ]] || die "$name not found at: $exe (re-run neuraldsp sync)"
  export PIPEWIRE_QUANTUM="${PIPEWIRE_QUANTUM:-128/48000}"
  log "opening $name (quantum $PIPEWIRE_QUANTUM; log: $logf)"
  if [[ "$slug" != "ilok" ]]; then
    log "first run? In the app's audio settings pick: PipeASIO, guitar input, headphone output."
  fi
  if wine "$exe" >>"$logf" 2>&1; then
    return 0
  else
    local code=$?
    notify critical "$name" "Exited ($code). Log: $logf"
    die "$name exited ($code). See $logf"
  fi
}

cmd_launch() {
  require_user
  [[ $# -ge 1 ]] || die "usage: neuraldsp launch <name>"
  if [[ "$1" == "ilok" ]]; then
    local exe
    exe="$(ilok_detect)" || die "iLok not installed yet — run: neuraldsp sync"
    run_standalone "ilok" "iLok License Manager" "$exe"
    return 0
  fi
  local out first
  out="$(match_app "$1")"
  first="$(printf '%s' "$out" | head -1)"
  if [[ "$first" == "NONE" ]]; then
    cmd_list || true
    die "no standalone matches '$1'"
  fi
  if [[ "$first" == "MULTI" ]]; then
    printf '%s\n' "$out" | tail -n +2
    die "multiple matches for '$1' — be more specific"
  fi
  run_standalone "$(printf '%s' "$first" | cut -f1)" "$(printf '%s' "$first" | cut -f2)" "$(printf '%s' "$first" | cut -f3)"
}

cmd_list() {
  if [[ ! -f "$APPS_JSON" ]]; then
    log "nothing installed yet — run: neuraldsp sync"
    return 0
  fi
  if [[ "${1:-}" == "--json" ]]; then cat "$APPS_JSON"; return 0; fi
  python3 - "$APPS_JSON" <<'EOF'
import json, sys
apps = json.load(open(sys.argv[1])).get("apps", [])
if not apps:
    print("neuraldsp: nothing installed yet — run: neuraldsp sync")
else:
    for a in apps:
        print(f"{a['slug']:<28} {a['name']}")
EOF
}

cmd_doctor() {
  local fail=0
  say() { printf '[%s] %s\n' "$1" "$2"; [[ "$1" != FAIL ]] || fail=1; }
  ensure_dirs
  command -v wine >/dev/null 2>&1 && say PASS "wine $(wine --version 2>/dev/null)" || say FAIL "wine not found"
  [[ -d "$NEURALDSP_PREFIX/drive_c" ]] && say PASS "prefix: $NEURALDSP_PREFIX" || say FAIL "prefix missing — run: neuraldsp sync"
  if pipeasio_present; then say PASS "PipeASIO registered in prefix"; else say FAIL "PipeASIO missing — run: neuraldsp sync"; fi
  dxvk_present && say PASS "DXVK present" || say WARN "DXVK missing — run: neuraldsp sync"
  ilok_detect >/dev/null && say PASS "iLok License Manager installed" || say WARN "iLok not installed — run: neuraldsp sync"
  vcrun_present && say PASS "vcrun2022 present" || say WARN "vcrun2022 missing — run: neuraldsp sync"
  say INFO "iLok sign-in happens in License Manager — this tool never handles passwords"
  if id -nG 2>/dev/null | tr ' ' '\n' | grep -qx realtime; then say PASS "realtime group active"; else say WARN "not in realtime group (or re-login pending) — audio may xrun under load"; fi
  if systemctl --user is-active --quiet pipewire 2>/dev/null; then say PASS "PipeWire active"; else say WARN "PipeWire not active"; fi
  if command -v pactl >/dev/null 2>&1; then
    say INFO "sinks: $(pactl list sinks short 2>/dev/null | awk '{print $2}' | tr '\n' ' ')"
  fi
  say INFO "launch quantum: ${PIPEWIRE_QUANTUM:-128/48000} (override with PIPEWIRE_QUANTUM env)"
  say INFO "interface presence is info-only — apps always open, with or without hardware plugged in"
  if [[ -f "$APPS_JSON" ]]; then
    say INFO "catalog: $(python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1])).get("apps",[])))' "$APPS_JSON") standalone(s)"
  else
    say INFO "catalog: empty — run: neuraldsp sync"
  fi
  [[ $fail -eq 0 ]] || die "doctor found failures — fix the FAIL lines above"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  add) cmd_add "$@" ;;
  sync) cmd_sync "$@" ;;
  launch) cmd_launch "$@" ;;
  list) cmd_list "$@" ;;
  doctor) cmd_doctor "$@" ;;
  -h|--help|help|"") usage ;;
  *) die "unknown command: $cmd (see: neuraldsp --help)" ;;
esac
